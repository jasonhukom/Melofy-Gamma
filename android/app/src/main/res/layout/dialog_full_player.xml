<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/btn_collapse"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:contentDescription="Collapse"
            android:src="@android:drawable/arrow_down_float"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:letterSpacing="0.1"
                android:text="PLAYING FROM LIBRARY"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_full_album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:text="Lyra Melofy Player"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Album Cover -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="24dp"
        android:layout_weight="1"
        android:gravity="center">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_full_cover"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:contentDescription="Full Cover Art"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Large" />
    </FrameLayout>

    <!-- Title, Artist, Like & Download -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/layout_actions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_full_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_full_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope"
                    android:maxLines="1"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tag_offline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#3310B981"
                    android:fontFamily="@font/space_grotesk"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="OFFLINE"
                    android:textColor="@color/green_online"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_full_like"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Like Song"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="@color/text_muted" />

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp">

                <ImageView
                    android:id="@+id/btn_full_download"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Download Song"
                    android:src="@drawable/ic_download_solid"
                    app:tint="@color/text_muted" />

                <ProgressBar
                    android:id="@+id/progress_full_download"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Seeker Slider & Timers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/seeker_full_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:progressTint="@color/yellow_primary"
            android:thumbTint="@color/yellow_primary" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/text_full_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/manrope"
                android:text="00:00"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_full_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/manrope"
                android:text="03:30"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_full_shuffle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:contentDescription="Shuffle"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@color/text_muted" />

        <ImageView
            android:id="@+id/btn_full_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Previous"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/text_primary" />

        <FrameLayout
            android:id="@+id/btn_full_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_circle_purple_gradient">

            <ImageView
                android:id="@+id/img_full_play_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="Play/Pause"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/bg_void" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_full_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:contentDescription="Next"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/text_primary" />

        <ImageView
            android:id="@+id/btn_full_repeat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:contentDescription="Repeat"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_muted" />
    </LinearLayout>

</LinearLayout>
