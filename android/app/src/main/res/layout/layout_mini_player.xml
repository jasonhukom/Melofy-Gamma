<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_elevated"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img_mini_cover"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Mini Cover"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_mini_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_mini_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_mini_play_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Play or Pause"
            android:padding="6dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/yellow_primary" />

        <ImageView
            android:id="@+id/btn_mini_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Next"
            android:padding="6dp"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_mini_player"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="1000"
        android:progressDrawable="@drawable/custom_progress_drawable" />

</LinearLayout>
